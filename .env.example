# Скопируйте этот файл в .env и подставьте свои значения.

# --- Ключи провайдеров поиска ---
OMDB_API_KEY=
TMDB_API_KEY=

# --- Сессии ---
# Любая длинная случайная строка. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- База данных ---
# Если DATABASE_URL задан, используется PostgreSQL (так работает на Render).
# Если не задан, локально поднимается файловый SQLite из SQLITE_PATH.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
SQLITE_PATH=./data/listoffilms.sqlite

PORT=3000
NODE_ENV=development
